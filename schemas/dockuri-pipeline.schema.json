{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.org/schemas/dockuri-pipeline-v1.json",
  "title": "Wellmanifest Dockuri Pipeline & Workflow Schema (dockuri/workflow-v1)",
  "description": "Normative schema for declaring URI process pipelines, dependencies, and RFC 6901 data flow references.",
  "type": "object",
  "required": ["name", "flow"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Identifier for the workflow/pipeline."
    },
    "description": {
      "type": "string"
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 4
    },
    "flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "uri", "input"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Unique identifier of this pipeline stage."
          },
          "uri": {
            "type": "string",
            "pattern": "^proc://[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/v[0-9]+$",
            "description": "Canonical Process URI."
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "List of stage IDs that must complete before this step."
          },
          "input": {
            "type": "object",
            "description": "Input payload with literal values or {\"$from\": \"<stage_id>\", \"path\": \"/json/pointer\"} references."
          }
        }
      }
    }
  }
}
